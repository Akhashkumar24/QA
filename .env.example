# Copy to .env (gitignored) and `set -a; . ./.env; set +a` before a live run.
# Nothing secret is committed — every value below is read via ${VAR} in conf/.

# --- AWS profile overrides (optional; defaults live in conf/profiles.yaml) ---
LAMBDA_AWS_PROFILE=AC_Digital_BAT
GLUE_AWS_PROFILE=AC_Digital_BAT
S3_AWS_PROFILE=ODH_UAT
CDM_AWS_PROFILE=ODH_UAT
CEP_AWS_PROFILE=CEP_ACNP_BAT

# --- where to find use-case config (optional; default: <repo>/conf) ---
# AWS_TESTKIT_CONF=/path/to/conf

# --- ground_time DB reconciliation (required only for that use case) ---
DB_SSH_HOST=127.0.0.1
DB_SSH_PORT=13408
DB_SSH_USERNAME=ec2devuser
DB_SSH_PASSWORD=
DB_MYSQL_HOST=
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=dbdevuser
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=FlightScheduleDataStore
SSM_INSTANCE_ID=

# --- misc per-use-case knobs ---
CDM_DERIVED_EVENT_PUBLISHER_LAMBDA=ac-odh-CDM-Event-Processor-uatca1
CDM_DLQ_WAIT_SECONDS=300
FLIGHT_EVENTS_DATE=
